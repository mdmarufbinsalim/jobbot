{
  "manifest_version": 3,
  "name": "Jobbot",
  "version": "1.0.0",
  "description": "Amazon hiring assistant. Runs in this Chrome, or controls a headless jobbot server over HTTP.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "cookies",
    "debugger"
  ],
  "host_permissions": [
    "https://*.hiring.amazon.ca/*",
    "https://*.hiring.amazon.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://temp-number.com/*",
    "https://www.temp-number.com/*",
    "https://*.amazon.in/remoteKYC*",
    "https://*.amazon.com/remoteKYC*",
    "https://*.amazon.ca/remoteKYC*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hiring.amazon.ca/*",
        "https://*.hiring.amazon.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.hiring.amazon.ca/*",
        "https://*.hiring.amazon.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Jobbot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
