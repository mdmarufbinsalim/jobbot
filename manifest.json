{
  "manifest_version": 3,
  "name": "Jobbot",
  "version": "0.7.0",
  "description": "Shows the current step of the Amazon hiring flow (search, job, application, login) plus a live GraphQL inspector.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.hiring.amazon.ca/*",
    "https://*.hiring.amazon.com/*",
    "https://temp-number.com/*",
    "https://www.temp-number.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hiring.amazon.ca/*",
        "https://*.hiring.amazon.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.hiring.amazon.ca/*",
        "https://*.hiring.amazon.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://auth.hiring.amazon.com/*",
        "https://auth.hiring.amazon.ca/*"
      ],
      "js": [
        "login.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://temp-number.com/*",
        "https://www.temp-number.com/*"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hiring.amazon.com/application/*",
        "https://hiring.amazon.ca/application/*"
      ],
      "js": [
        "application.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hiring.amazon.com/app*",
        "https://hiring.amazon.ca/app*"
      ],
      "js": [
        "search.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amazon.in/remoteKYC*",
        "https://*.amazon.com/remoteKYC*",
        "https://*.amazon.ca/remoteKYC*"
      ],
      "js": [
        "kyc.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jobbot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
