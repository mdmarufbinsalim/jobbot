[Unit]
Description=Jobbot server (headless browser + HTTP API on 127.0.0.1:8787)
After=network-online.target
Wants=network-online.target

[Service]
User=jobbot
Group=jobbot
WorkingDirectory=/opt/jobbot/current/server
EnvironmentFile=/etc/jobbot/env
Environment=HOME=/var/lib/jobbot
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/jobbot/browsers
Environment=NODE_ENV=production
# Localhost only: reach it through an SSH tunnel (the API is plain HTTP + bearer token).
ExecStart=/usr/bin/node bin/server.js serve --host 127.0.0.1 --port 8787 --out /var/lib/jobbot/out
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# This box is shared and tight on memory: the browser may never take the others down with it.
MemoryHigh=1200M
MemoryMax=1500M
CPUQuota=150%
TasksMax=512
OOMScoreAdjust=500

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/jobbot

[Install]
WantedBy=multi-user.target
